# Variables de entorno del backend en la VM.
# Copia este archivo a /opt/gestorhorarios/gestorhorarios.env y cambia los valores.
# Spring Boot las usa por encima de lo que trae application.properties dentro del jar.

# --- Servidor ---
SERVER_PORT=8081
# 127.0.0.1: el back solo acepta conexiones de la propia VM; desde fuera
# se llega únicamente por el túnel de ngrok (no hay que abrir puertos).
SERVER_ADDRESS=127.0.0.1

# --- Base de datos Oracle AI Database Free instalada en la VM (listener en 31877) ---
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:31877/FREEPDB1
SPRING_DATASOURCE_USERNAME=samuel
SPRING_DATASOURCE_PASSWORD=CAMBIAR_misma_clave_que_usas_en_desarrollo

# --- Seguridad ---
# Genera uno nuevo en la VM con:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CAMBIAR_por_un_secreto_largo_aleatorio
# URL de tu sitio en Netlify (sin "/" al final). Varias separadas por coma.
APP_FRONTEND_ALLOWEDORIGINS=https://TU-SITIO.netlify.app

# --- Usuario administrador inicial ---
APP_ADMIN_NOMBREUSUARIO=admin
APP_ADMIN_CONTRASENA=CAMBIAR_clave_admin
